---
// Ruta "catch-all": genera UNA página por cada artículo de la colección
// `guides`, en cualquiera de los 4 idiomas, desde un solo archivo.
//   EN     -> /how-to-get-to-ilha-grande/
//   FR/PT/ES -> /fr/comment-aller-a-ilha-grande/  (con prefijo de idioma)
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import RouteMap from '../components/RouteMap.astro';
import IslandMap from '../components/IslandMap.astro';
import BeachesMap from '../components/BeachesMap.astro';
import BeachesDirectory from '../components/BeachesDirectory.astro';
import ContactForm from '../components/ContactForm.astro';
import Portrait from '../components/Portrait.astro';
import { getAlternates } from '../lib/content';
import { localizedPath } from '../i18n/config';
import { t } from '../i18n/ui';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((entry) => {
    const { lang, slug } = entry.data;
    const path = lang === 'en' ? slug : `${lang}/${slug}`;
    return { params: { slug: path }, props: { entry, guides } };
  });
}

const { entry, guides } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const alternates = getAlternates(guides, data.translationKey);
const canonical = new URL(localizedPath(data.lang, data.slug), Astro.site!).href;

// --- Datos estructurados de la página ---
const schemas: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    inLanguage: data.lang,
    datePublished: data.updatedDate.toISOString(),
    dateModified: data.updatedDate.toISOString(),
    author: { '@type': 'Person', name: data.author },
    mainEntityOfPage: canonical,
  },
];

if (data.faq && data.faq.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}

// En la página "About" añadimos un Person (E-E-A-T): le dice a Google/IA
// que detrás de la guía hay una persona real, residente y con credenciales.
if (data.translationKey === 'about') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: data.author,
    description:
      'Author of the Visit Ilha Grande travel guide; lives on Ilha Grande and runs Pousada CostaVerde in Vila do Abraão.',
    url: canonical,
    homeLocation: {
      '@type': 'Place',
      name: 'Ilha Grande, Angra dos Reis, Rio de Janeiro, Brazil',
    },
    worksFor: {
      '@type': 'Organization',
      name: 'Pousada CostaVerde',
      url: 'https://pousadacostaverde.com',
    },
    sameAs: ['https://pousadacostaverde.com'],
  });
}

// Imagen social (OG) por pilar: cuando alguien comparte el link por
// WhatsApp/redes, aparece una postal de la isla en vez de una URL pelada.
const OG_BY_KEY: Record<string, string> = {
  'getting-there': '/og/getting-there.jpg',
  'where-to-stay': '/og/where-to-stay.jpg',
  beaches: '/og/beaches.jpg',
  trails: '/og/trails.jpg',
  'best-time': '/og/best-time.jpg',
  faq: '/og/faq.jpg',
  food: '/og/food.jpg',
  about: '/og/about.jpg',
};
const ogImage = OG_BY_KEY[data.translationKey] ?? '/og/default.jpg';
---
<BaseLayout
  lang={data.lang}
  title={data.title}
  description={data.description}
  path={data.slug}
  alternates={alternates}
  extraSchemas={schemas}
  ogImage={ogImage}
>
  <div class="prose">
    <article>
      <h1>{data.title}</h1>
      {entry.data.translationKey === 'about' && <Portrait lang={data.lang} />}
      {entry.data.translationKey === 'getting-there' && <RouteMap lang={data.lang} />}
      {entry.data.translationKey === 'trails' && <IslandMap lang={data.lang} />}
      {entry.data.translationKey === 'beaches' && <BeachesMap lang={data.lang} />}
      <Content />
      {entry.data.translationKey === 'beaches' && <BeachesDirectory lang={data.lang} />}
      {entry.data.translationKey === 'about' && <ContactForm lang={data.lang} />}
    </article>

    <AuthorBox lang={data.lang} author={data.author} />

    {data.faq && data.faq.length > 0 && (
      <section class="faq" aria-label={t(data.lang, 'faq_title')}>
        <h2>{t(data.lang, 'faq_title')}</h2>
        {data.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>
    )}
  </div>
</BaseLayout>
