---
// Formulario de contacto vía Web3Forms (gratis, sin backend).
// Los mensajes llegan al email asociado a la "access key".
// La access key de Web3Forms es PÚBLICA (va en el cliente sin riesgo).
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// 👉 Reemplazar por tu clave real de https://web3forms.com (es pública).
const WEB3FORMS_KEY = 'YOUR_WEB3FORMS_ACCESS_KEY';
---
<form class="contact-form" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
  <p class="contact-success" hidden>{t(lang, 'contact_success')}</p>

  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value="Nuevo mensaje desde visitilhagrande.com" />
  <input type="hidden" name="from_name" value="Visit Ilha Grande" />
  <input type="hidden" name="lang" value={lang} />

  <!-- Honeypot anti-spam de Web3Forms: invisible para humanos -->
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

  <label>
    <span>{t(lang, 'contact_name')}</span>
    <input type="text" name="name" required />
  </label>
  <label>
    <span>{t(lang, 'contact_email')}</span>
    <input type="email" name="email" required />
  </label>
  <label>
    <span>{t(lang, 'contact_message')}</span>
    <textarea name="message" rows="5" required></textarea>
  </label>

  <button type="submit">{t(lang, 'contact_send')}</button>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = form?.querySelector('.contact-success');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (button) button.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.reset();
        success?.removeAttribute('hidden');
        success?.scrollIntoView({ behavior: 'smooth' });
      }
    } catch (_) {
      /* silencioso */
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
