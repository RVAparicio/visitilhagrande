---
// Galería responsiva de fotos optimizadas (astro:assets → AVIF/WebP).
// Recibe items {src, alt, caption} ya resueltos (ver src/i18n/galleries.ts) y
// el idioma para el caption. Grid fluido; clic abre la foto a tamaño completo.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/config';

interface Item {
  src: ImageMetadata;
  alt: Record<Lang, string>;
  caption?: string;
}
interface Props { items: Item[]; lang: Lang; title?: string; }
const { items, lang, title } = Astro.props;
---
{items.length > 0 && (
  <section class="gallery" aria-label={title ?? 'Gallery'}>
    {title && <h2>{title}</h2>}
    <div class="gallery__grid">
      {items.map((it) => (
        <figure class="gallery__item">
          <a href={it.src.src} target="_blank" rel="noopener" aria-label={it.alt[lang]}>
            <Image
              src={it.src}
              alt={it.alt[lang]}
              widths={[400, 800, 1200]}
              sizes="(min-width: 1000px) 30rem, (min-width: 640px) 45vw, 92vw"
              loading="lazy"
            />
          </a>
          {it.caption && <figcaption>{it.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </section>
)}

<style>
  .gallery { margin: 2.5rem 0; }
  .gallery h2 { margin: 0 0 1rem; }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .gallery__item { margin: 0; }
  .gallery__item a { display: block; overflow: hidden; border-radius: var(--radius); }
  .gallery__item :global(img) {
    display: block;
    width: 100%;
    height: 13rem;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gallery__item a:hover :global(img) { transform: scale(1.05); }
  .gallery__item figcaption {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--c-muted);
    line-height: 1.45;
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery__item :global(img) { transition: none; }
    .gallery__item a:hover :global(img) { transform: none; }
  }
</style>
