---
// Caja de autor visible en cada artículo (E-E-A-T): refuerza que la guía
// la firma una persona real, residente en la isla.
import { Image } from 'astro:assets';
import avatar from '../assets/richard-avatar.jpg';
import { t } from '../i18n/ui';
import { localizedPath, type Lang } from '../i18n/config';
import { routes } from '../i18n/routes';

interface Props {
  lang: Lang;
  author?: string;
}

const { lang, author = 'Ricardo Aparicio' } = Astro.props;
const aboutPath = localizedPath(lang, routes.about[lang]);

const avatarAlt: Record<Lang, string> = {
  en: 'Ricardo Aparicio, author of the Visit Ilha Grande guide and a resident of the island.',
  fr: "Ricardo Aparicio, auteur du guide Visit Ilha Grande et résident de l'île.",
  pt: 'Ricardo Aparicio, autor do guia Visit Ilha Grande e morador da ilha.',
  es: 'Ricardo Aparicio, autor de la guía Visit Ilha Grande y residente de la isla.',
};
---
<aside class="author-box">
  <Image
    class="author-box__avatar"
    src={avatar}
    alt={avatarAlt[lang]}
    width={96}
    height={96}
    loading="lazy"
  />
  <div>
    <p class="author-box__name">
      {t(lang, 'author_prefix')} <a href={aboutPath}>{author}</a>
    </p>
    <p class="author-box__bio">{t(lang, 'author_bio')}</p>
    <p class="author-box__link"><a href={aboutPath}>{t(lang, 'nav_about')} →</a></p>
  </div>
</aside>
