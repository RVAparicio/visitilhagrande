---
// Caja de autor visible en cada artículo (E-E-A-T): refuerza que la guía
// la firma una persona real, residente en la isla.
import { t } from '../i18n/ui';
import { localizedPath, type Lang } from '../i18n/config';
import { routes } from '../i18n/routes';

interface Props {
  lang: Lang;
  author?: string;
}

const { lang, author = 'Richard' } = Astro.props;
const aboutPath = localizedPath(lang, routes.about[lang]);
---
<aside class="author-box">
  <div class="author-box__avatar" aria-hidden="true">R</div>
  <div>
    <p class="author-box__name">
      {t(lang, 'author_prefix')} <a href={aboutPath}>{author}</a>
    </p>
    <p class="author-box__bio">{t(lang, 'author_bio')}</p>
    <p class="author-box__link"><a href={aboutPath}>{t(lang, 'nav_about')} →</a></p>
  </div>
</aside>
