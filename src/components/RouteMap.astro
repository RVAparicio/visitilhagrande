---
// Mapa de las rutas marítimas hacia Vila do Abraão, en estilo carta náutica /
// mapa del tesoro (imagen estática de Richard). Real: muestra los tres puertos
// del continente (Mangaratiba, Angra dos Reis, Conceição de Jacareí), sus rutas
// de ida y vuelta y la X de destino. Astro lo sirve optimizado (AVIF/WebP).
import { Picture } from 'astro:assets';
import routesMap from '../assets/rutas/ilha-grande-boat-routes-map.png';
import type { Lang } from '../i18n/config';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const S: Record<Lang, { desc: string; caption: string }> = {
  en: { desc: 'Map of the bay showing the three mainland ports — Mangaratiba, Angra dos Reis and Conceição de Jacareí — and their boat routes to Vila do Abraão on Ilha Grande.', caption: 'The three crossings to Vila do Abraão (round-trip): speedboat from Conceição de Jacareí (~15 min) and Angra dos Reis (~20–30 min); public ferry from Mangaratiba (~1h10–1h30) and Angra.' },
  fr: { desc: "Carte de la baie montrant les trois ports du continent — Mangaratiba, Angra dos Reis et Conceição de Jacareí — et leurs liaisons en bateau vers Vila do Abraão à Ilha Grande.", caption: 'Les trois traversées vers Vila do Abraão (aller-retour) : vedette depuis Conceição de Jacareí (~15 min) et Angra dos Reis (~20–30 min) ; ferry public depuis Mangaratiba (~1h10–1h30) et Angra.' },
  pt: { desc: 'Mapa da baía mostrando os três portos do continente — Mangaratiba, Angra dos Reis e Conceição de Jacareí — e suas rotas de barco até a Vila do Abraão, na Ilha Grande.', caption: 'As três travessias até a Vila do Abraão (ida e volta): lancha de Conceição de Jacareí (~15 min) e Angra dos Reis (~20–30 min); barca pública de Mangaratiba (~1h10–1h30) e Angra.' },
  es: { desc: 'Mapa de la bahía que muestra los tres puertos del continente — Mangaratiba, Angra dos Reis y Conceição de Jacareí — y sus rutas de barco a Vila do Abraão en Ilha Grande.', caption: 'Las tres travesías a Vila do Abraão (ida y vuelta): lancha desde Conceição de Jacareí (~15 min) y Angra dos Reis (~20–30 min); barca pública desde Mangaratiba (~1h10–1h30) y Angra.' },
};
const t = S[lang];
---
<figure class="route-map">
  <Picture
    src={routesMap}
    formats={['avif', 'webp']}
    alt={t.desc}
    widths={[632, 948, 1264]}
    sizes="(min-width: 1000px) 60rem, 92vw"
    loading="lazy"
  />
  <figcaption>{t.caption}</figcaption>
</figure>

<style>
  .route-map { margin: 1.5rem 0; }
  .route-map :global(img) { display: block; width: 100%; height: auto; border-radius: var(--radius); box-shadow: 0 3px 14px rgba(14,58,74,0.16); }
  .route-map figcaption { margin-top: .6rem; font-size: .9rem; color: var(--c-muted); text-align: center; }
</style>
