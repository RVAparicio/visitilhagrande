---
// Home "Ficha de campo": un solo componente para los 4 idiomas.
// Hero dividido (intro + polaroids con parallax | ficha técnica),
// botonera-pestañas a los 6 pilares, postales rotativas y prosa SEO.
import { Image } from 'astro:assets';
import { localizedPath, type Lang } from '../i18n/config';
import { routes } from '../i18n/routes';
import { t } from '../i18n/ui';

// Polaroids del hero (2, distintas de las postales de abajo)
import shotAventureiro from '../assets/praia-do-aventureiro-leaning-palm-ilha-grande.jpg';
import shotCataguas from '../assets/cataguas-islet-aerial-ilha-grande.jpg';
// Postales rotativas (3, los lugares citados)
import cardLopes from '../assets/lopes-mendes-aerial-ilha-grande.jpg';
import cardPico from '../assets/pico-do-papagaio-summit-sunrise-ilha-grande.jpg';
import cardLagoa from '../assets/lagoa-azul-fish-ilha-grande.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

interface HomeCopy {
  h1a: string;
  h1b: string;
  sub: string;
  start: string;
  fichaTitle: string;
  fAccess: string;
  fAccessV: string;
  fBeaches: string;
  fTrails: string;
  fTrailsV: string;
  fPeak: string;
  fMonth: string;
  fMonthV: string;
  fLangs: string;
  cards: { title: string; cap: string }[];
  p1: string;
  p2: string;
  footerLine: string;
  footerCta: string;
}

const copy: Record<Lang, HomeCopy> = {
