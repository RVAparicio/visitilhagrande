    footerCta: 'Quién escribe esto →',
  },
};
const c = copy[lang];

const tabs = [
  { n: '①', label: t(lang, 'nav_getting_there'), slug: routes.gettingThere[lang], bg: '#0E3A4A', fg: '#EFE6D6' },
  { n: '②', label: t(lang, 'nav_stay'), slug: routes.whereToStay[lang], bg: '#1B9C8F', fg: '#04241f' },
  { n: '③', label: t(lang, 'nav_beaches'), slug: routes.beaches[lang], bg: '#245F46', fg: '#EFE6D6' },
  { n: '④', label: t(lang, 'nav_trails'), slug: routes.trails[lang], bg: '#E8A14C', fg: '#3A2306' },
  { n: '⑤', label: t(lang, 'nav_best_time'), slug: routes.bestTime[lang], bg: '#145062', fg: '#EFE6D6' },
  { n: '⑥', label: t(lang, 'nav_faq'), slug: routes.faq[lang], bg: '#4F6168', fg: '#EFE6D6' },
  { n: '⑦', label: t(lang, 'nav_food'), slug: routes.food[lang], bg: '#B5532E', fg: '#EFE6D6' },
];

const ficha: { label: string; value: string; slug?: string; accent?: boolean }[] = [
  { label: c.fAccess, value: c.fAccessV, slug: routes.gettingThere[lang] },
  { label: c.fBeaches, value: '113', slug: routes.beaches[lang] },
  { label: c.fTrails, value: c.fTrailsV, slug: routes.trails[lang] },
  { label: c.fPeak, value: 'Pico do Papagaio · 982 m', slug: routes.trails[lang] },
  { label: c.fMonth, value: c.fMonthV, slug: routes.bestTime[lang], accent: true },
  { label: c.fLangs, value: 'EN · FR · PT · ES' },
];

const cardHrefs = [
  localizedPath(lang, routes.beaches[lang]),
  localizedPath(lang, routes.trails[lang]),
  localizedPath(lang, routes.beaches[lang]),
];
const cardImgs = [cardLopes, cardPico, cardLagoa];
---
<section class="hero2">
  <div class="hero2__grid">
    <div class="hero2__intro">
      <span class="hero2__stamp">23°09′S · 44°14′W</span>
      <h1>{c.h1a}<br />{c.h1b}</h1>
      <p class="hero2__sub">{c.sub}</p>
      <a class="hero2__start" href={localizedPath(lang, routes.gettingThere[lang])}>{c.start}</a>

      <div class="hero2__shots">
        <div class="shot-wrap shot-wrap--a" data-parallax="-0.07">
          <div class="shot shot--a">
            <Image src={shotAventureiro} alt="Praia do Aventureiro, Ilha Grande" widths={[200, 400]} sizes="11.5rem" loading="eager" />
          </div>
        </div>
        <div class="shot-wrap shot-wrap--b" data-parallax="-0.04">
          <div class="shot shot--b">
            <Image src={shotCataguas} alt="Cataguás, Ilha Grande" widths={[200, 400]} sizes="11.5rem" loading="eager" />
          </div>
        </div>
      </div>
    </div>

    <aside class="hero2__ficha">
      <p class="ficha__title">{c.fichaTitle}</p>
      <table class="ficha__table">
        <tbody>
          {ficha.map((row) => (
            <tr>
              <td class="lab">{row.label}</td>
              <td class={`val${row.accent ? ' val--accent' : ''}`}>
                {row.slug ? <a href={localizedPath(lang, row.slug)}>{row.value}</a> : row.value}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </aside>
  </div>
</section>

<nav class="tabs2" aria-label={t(lang, 'footer_explore')}>
  {tabs.map((tab) => (
    <a class="tab2" href={localizedPath(lang, tab.slug)} style={`background:${tab.bg};color:${tab.fg}`}>
      {tab.n} {tab.label}
    </a>
  ))}
</nav>

<div class="postcards">
  {c.cards.map((card, i) => (
    <a class={`postcard${i === 0 ? ' is-active' : ''}`} href={cardHrefs[i]}>
      <Image src={cardImgs[i]} alt={`${card.title}, Ilha Grande`} widths={[300, 600]} sizes="(min-width: 1000px) 22rem, 92vw" loading="lazy" />
      <span class="postcard__body">
        <span class="postcard__title">{card.title}</span>
        <span class="postcard__cap">{card.cap}</span>
      </span>
    </a>
  ))}
</div>

<div class="prose home-prose">
  <p set:html={c.p1} />
  <p set:html={c.p2} />
</div>

<div class="field-footer">
  <div class="field-footer__inner">
    <span>{c.footerLine}</span>
    <a href={localizedPath(lang, routes.about[lang])}>{c.footerCta}</a>
  </div>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    const cards = Array.from(document.querySelectorAll('.postcard'));
    if (cards.length) {
      let i = 0;
      let paused = false;
      const strip = document.querySelector('.postcards');
      strip?.addEventListener('mouseenter', () => (paused = true));
      strip?.addEventListener('mouseleave', () => (paused = false));
      setInterval(() => {
        if (paused) return;
        cards[i]?.classList.remove('is-active');
        i = (i + 1) % cards.length;
        cards[i]?.classList.add('is-active');
      }, 3500);
    }
    const shots = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    if (shots.length) {
      const onScroll = () => {
        const y = window.scrollY;
        for (const el of shots) {
          const f = parseFloat(el.dataset.parallax || '0');
          el.style.transform = `translateY(${y * f}px)`;
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
</script>
