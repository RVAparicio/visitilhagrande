---
import { Image } from 'astro:assets';
import LangSwitcher from './LangSwitcher.astro';
import logo from '../assets/logo-round.png';
import { localizedPath, type Lang } from '../i18n/config';
import { routes } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: { lang: Lang; path: string }[];
}

const { lang, alternates } = Astro.props;
const home = localizedPath(lang, '');
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="logo" href={home}>
      <Image class="logo__mark" src={logo} alt="" width={68} height={68} loading="eager" />
      <span>Visit Ilha Grande</span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href={home}>{t(lang, 'nav_home')}</a>
      <a href={localizedPath(lang, routes.gettingThere[lang])}>{t(lang, 'nav_getting_there')}</a>
      <a href={localizedPath(lang, routes.beaches[lang])}>{t(lang, 'nav_beaches')}</a>
      <a href={localizedPath(lang, routes.trails[lang])}>{t(lang, 'nav_trails')}</a>
    </nav>
    <LangSwitcher lang={lang} alternates={alternates} />
  </div>
</header>
