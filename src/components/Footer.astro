---
// Footer con el DISCLOSURE de autoría (principio innegociable del brief:
// transparencia total de quién escribe y mantiene la guía).
import { t } from '../i18n/ui';
import { localizedPath, type Lang } from '../i18n/config';
import { routes } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const aboutPath = localizedPath(lang, routes.about[lang]);
---
<footer class="site-footer">
  <div class="container">
    <p class="disclosure">{t(lang, 'footer_disclosure')}</p>
    <p class="footer-meta">
      © {year} Visit Ilha Grande · <a href={aboutPath}>{t(lang, 'nav_about')}</a>
    </p>
  </div>
</footer>
