---
// Footer con el DISCLOSURE de autoría (principio innegociable del brief:
// transparencia total de quién escribe y mantiene la guía).
import { t } from '../i18n/ui';
import { localizedPath, type Lang } from '../i18n/config';
import { routes } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();

const links: { key: Parameters<typeof t>[1]; slug: string }[] = [
  { key: 'nav_getting_there', slug: routes.gettingThere[lang] },
  { key: 'nav_beaches', slug: routes.beaches[lang] },
  { key: 'nav_trails', slug: routes.trails[lang] },
  { key: 'nav_best_time', slug: routes.bestTime[lang] },
  { key: 'nav_faq', slug: routes.faq[lang] },
  { key: 'nav_about', slug: routes.about[lang] },
];
---
<footer class="site-footer">
  <div class="container">
    <nav class="footer-nav" aria-label={t(lang, 'footer_explore')}>
      <p class="footer-nav__title">{t(lang, 'footer_explore')}</p>
      <ul>
        {links.map((l) => (
          <li><a href={localizedPath(lang, l.slug)}>{t(lang, l.key)}</a></li>
        ))}
      </ul>
    </nav>
    <p class="disclosure">{t(lang, 'footer_disclosure')}</p>
    <p class="footer-meta">© {year} Visit Ilha Grande</p>
  </div>
</footer>
