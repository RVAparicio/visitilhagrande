---
// Retrato del autor para la página "Sobre" (E-E-A-T): una cara real
// refuerza la confianza ante lectores y ante los modelos de IA.
// Usa <Picture> de astro:assets: AVIF/WebP + tamaños responsivos.
import { Picture } from 'astro:assets';
import portrait from '../assets/richard-portrait.jpg';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const alt: Record<Lang, string> = {
  en: 'Portrait of Ricardo Aparicio, author of the Visit Ilha Grande guide, who lives on Ilha Grande and runs Pousada CostaVerde in Vila do Abraão.',
  fr: "Portrait de Ricardo Aparicio, auteur du guide Visit Ilha Grande, qui vit à Ilha Grande et tient la Pousada CostaVerde à Vila do Abraão.",
  pt: 'Retrato de Ricardo Aparicio, autor do guia Visit Ilha Grande, que mora na Ilha Grande e administra a Pousada CostaVerde na Vila do Abraão.',
  es: 'Retrato de Ricardo Aparicio, autor de la guía Visit Ilha Grande, que vive en Ilha Grande y lleva la Pousada CostaVerde en Vila do Abraão.',
};
---
<figure class="portrait">
  <Picture
    src={portrait}
    formats={['avif', 'webp']}
    alt={alt[lang]}
    widths={[320, 520, 800]}
    sizes="(min-width: 700px) 18rem, 60vw"
    loading="eager"
  />
</figure>
