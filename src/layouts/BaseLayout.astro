---
// Plantilla base común a TODAS las páginas del sitio.
// Centraliza <head>, SEO, hreflang y los datos estructurados globales.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Hreflang from '../components/Hreflang.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localizedPath, locales, type Lang } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  // Slug lógico de la página actual en su idioma (sin prefijo de idioma).
  // Ej: 'beaches', 'fr/plages' NO -> solo 'plages'. Para la home: ''.
  path?: string;
  // Versiones equivalentes en otros idiomas (para el hreflang).
  // Si no se pasa, asume mismo slug en los 4 idiomas (sirve para la home).
  alternates?: { lang: Lang; path: string }[];
  // Datos estructurados adicionales de la página (Article, FAQPage, etc.).
  extraSchemas?: object[];
}

const { lang, title, description, path = '', alternates, extraSchemas = [] } = Astro.props;
const site = Astro.site!;

const alts =
  alternates ?? locales.map((l) => ({ lang: l, path }));

const canonical = new URL(localizedPath(lang, path), site).href;

// JSON-LD global: el sitio (WebSite) y la organización que lo mantiene
// (la guía, NO la posada). Va en todas las páginas.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      url: `${site.origin}/`,
      name: 'Visit Ilha Grande',
      description: 'Local, multilingual travel guide to Ilha Grande, Brazil.',
      inLanguage: lang,
      publisher: { '@id': `${site.origin}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${site.origin}/#organization`,
      name: 'Visit Ilha Grande',
      url: `${site.origin}/`,
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <Hreflang alternates={alts} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Cloudflare Web Analytics: sin cookies, sin datos personales (RGPD) -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "33761d1a89d6432dafb7c03bd29bcb30"}'
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} alternates={alts} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
